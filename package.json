{
  "name": "nitinkotcherlakota-portfolio",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run lint && npm run type-check",
    "resume:markdown": "tsx scripts/generate-resume-markdown.ts",
    "resume:text": "tsx scripts/generate-resume-text.ts",
    "resume:docs": "npm run resume:markdown && npm run resume:text",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.2.18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.35",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.5",
    "typescript": "^5.7.3"
  }
}
